module

public import ImportGraph.Lean.Name
public import Lean.Elab.Declaration

/-!
# `ScopeCapsule`

This file defines a portable internal format for scopes that is less sensitive to the precise
state of `Scope` and can be more easily manipulated than the bare reified scope syntax.
-/

open ImportGraph Lean Meta Elab Command

public section

namespace ImportGraph.Splice

/-- A combination of the expanded `varDecl` and its `include`d/`omit`ted status, so that we can
more easily associate declarations with their statuses. -/
structure ScopeCapsule.Var where
  /-- The `variable` binder this came from, which may declare more than just this variable (e.g.
  `{a b c : Nat}`). -/
  srcDecl : TSyntax ``Parser.Term.bracketedBinder
  /-- The number of variables generated by this syntax. -/
  numVars : Nat
  /-- In `some (idx, ident)`, `idx` is the index of this variable's identifier/hole in the binder
  syntax that generated it (`srcDecl`), if present, and `ident` the name. E.g. `b` in
  `{a b c : Nat}` has `id? := some (1, <syntax for b>)`, and `[Foo α]` has `id? := none`. -/
  id? : Option (Nat × TSyntax [`ident, ``Parser.Term.hole])
  type? : Option Term
  annotation? :
    Option (TSyntax [``Lean.Parser.Term.binderTactic, ``Lean.Parser.Term.binderDefault]) := none
  binderInfo : BinderInfo
  /-- Whether the variable is among the `include`d variables. -/
  isIncluded := false
  /-- Whether the variable is among the `omit`ted variables. -/
  isOmitted := false
deriving Inhabited, Repr, BEq
-- Note: `Syntax.instBEq` uses `structEq`, ignoring whitespace, as desired.

namespace ScopeCapsule.Var

open Parser.Term in
/-- Expands a bracketed binder into one `Vars` per variable it introduces, in the same order as
`Lean.Elab.Command.getBracketedBinderIds`. The resulting `Vars` have their `isIncluded` and
`isOmitted` fields set to `false` by default. -/
def ofBracketedBinder (srcDecl : TSyntax ``bracketedBinder) : Array Var :=
  match srcDecl with
  | `(bracketedBinderF|($ids* $[: $ty?]? $(annotation?)?)) => mapIdents .default ids ty? annotation?
  | `(bracketedBinderF|{$ids* $[: $ty?]?}) => mapIdents .implicit ids ty? none
  | `(bracketedBinderF|⦃$ids* $[: $ty?]?⦄) => mapIdents .strictImplicit ids ty? none
  | `(bracketedBinderF|[$id : $ty]) =>
    #[{ srcDecl, numVars := 1, id? := some (0, id), type? := ty, binderInfo := .instImplicit }]
  | `(bracketedBinderF|[$ty]) =>
    #[{ srcDecl, numVars := 1, id? := none, type? := ty, binderInfo := .instImplicit }]
  | _ => #[]
where
  mapIdents (binderInfo : BinderInfo) (ids : TSyntaxArray [`ident, `Lean.Parser.Term.hole])
      (type?) (annotation?) : Array Var :=
    let numVars := ids.size
    ids.mapIdx fun idx id =>
      { srcDecl, numVars, id? := some (idx, id), type?, annotation?, binderInfo }

/-- Collects the binders from `vars`, deduplicating as appropriate. -/
def toVarBinders (vars : Array Var) : Array (TSyntax ``Parser.Term.bracketedBinder) := Id.run do
  let mut varDecls : Array (TSyntax ``Parser.Term.bracketedBinder) := #[]
  for var in vars do
    unless varDecls.contains var.srcDecl do
      varDecls := varDecls.push var.srcDecl
  return varDecls

end ScopeCapsule.Var

/-- Expands the `variable`s of `scope` into one `Vars` per variable, recording whether each is
`include`d or `omit`ted. Entries are in `varUIds` order (which is inherited from expanding
`varDecls`). Assumes the `Scope` is well-formed, i.e. that `varUIds` is the right size. -/
def Lean.Elab.Command.Scope.toVars (scope : Scope) : Array ScopeCapsule.Var := Id.run do
  let vars := scope.varDecls.flatMap ScopeCapsule.Var.ofBracketedBinder
  return vars.zipWith (bs := scope.varUIds) fun var uid =>
    { var with
      isIncluded := scope.includedVars.contains uid
      isOmitted := scope.omittedVars.contains uid }

/-- An intermediate representation of a scope that may be more easily operated on than syntax. -/
structure ScopeCapsule where
  /-- `noncomputable section`. Inherited from `Scope`. -/
  isNoncomputable : Bool := false
  /-- `public section`. Inherited from `Scope`. -/
  isPublic : Bool := false
  /-- `meta section`. Inherited from `Scope`. -/
  isMeta : Bool := false
  /-- `@[expose] section`. Not inherited from `Scope`; `Scope` records this in `attrs`.
  In the future, if `Scope` uses other `attrs`, it may be reasonable to relegate this to `attrs` as
  well. -/
  isExposed : Bool := false
  /-- `universe`s. Inherited from `Scope`. -/
  levelNames : List Name := []
  /-- Current `namespace`. Inherited from `Scope`. -/
  currNamespace : Name := .anonymous
  /-- Current `open`s. Inherited from `Scope`. -/
  openDecls : List OpenDecl := []
  /-- Current open scopes, created by `open scoped`, `open`, and `namespace`.
  Note that we only reify the *extra* open scopes (disregarding `open` and `namespace`) into syntax
  for compactness. -/
  activeScopes : NameSet := ∅
  /-- Current options set by the user, either in the current file or in the lakefile. Like `opts`
  in `Scope` but excludes internal `Option`s. -/
  userOpts : Options := ∅
  /-- Expanded `variable` syntax, plus `include`d and `omit`ted status. Note that a single binder/
  `varDecl` from the `Scope` may produce several variables, and hence several `varUIds` in the
  `Scope`. Each variable produced corresponds to a `Var`. -/
  vars : Array ScopeCapsule.Var := #[]

local instance : SDiff Bool where
  sdiff b₁ b₂ := b₁ && !b₂

/-- The longest common prefix of two names. -/
def Lean.Name.commonPrefix (n₁ n₂ : Name) : Name :=
  Elab.Command.findCommonPrefix [n₁, n₂]

scoped instance : Inter Name := ⟨Lean.Name.commonPrefix⟩

/-- The suffix of `n₁` after the common prefix with `n₂`. -/
def Lean.Name.sdiff (n₁ n₂ : Name) : Name :=
  n₁.replacePrefix (n₁ ∩ n₂) .anonymous

scoped instance : SDiff Name := ⟨Lean.Name.sdiff⟩

/-- The longest common prefix of two lists. -/
def List.commonPrefix [BEq α] : List α → List α → List α
  | a :: as, b :: bs => if a == b then a :: commonPrefix as bs else []
  | _, _ => []

/-- The suffix of `l₁` after the common prefix with `l₂`. -/
def List.sdiffByPrefix [BEq α] : List α → List α → List α
  | l₁@(a :: as), b :: bs => if a == b then sdiffByPrefix as bs else l₁
  | l₁, _ => l₁

/-- The intersection of two lists as sets, preserving the order of the first one. Does not
deduplicate. -/
abbrev List.inter [BEq α] (l₁ l₂ : List α) : List α :=
  l₁.filter l₂.contains

/-- The elements of `l₁` not in `l₂`. Does not deduplicate. -/
abbrev List.sdiff [BEq α] (l₁ l₂ : List α) : List α :=
  l₁.filter (!l₂.contains ·)

/-- The intersection of two lists as sets, preserving the order of the first one. Does not
deduplicate. -/
abbrev Array.inter [BEq α] (a₁ a₂ : Array α) : Array α :=
  a₁.filter a₂.contains

/-- The elements of `a₁` not in `a₂`. Does not deduplicate. -/
abbrev Array.sdiff [BEq α] (a₁ a₂ : Array α) : Array α :=
  a₁.filter (!a₂.contains ·)

/-- The option settings in both `opts₁` and `opts₂`. Only counts an option setting as occurring in
both if it has the same value in both. -/
def Lean.Options.inter (opts₁ opts₂ : Options) : Options := Id.run do
  let mut inter := ∅
  for (opt, val) in opts₁ do
    if opts₂.find? opt |>.isEqSome val then
      inter := inter.insert opt val
  return inter

scoped instance : Inter Options := ⟨Lean.Options.inter⟩

/-- The elements of `opts₁` not in `opts₂`. Includes options that are set in both but are set
differently. -/
def Lean.Options.sdiff (opts₁ opts₂ : Options) : Options := Id.run do
  let mut sdiff := ∅
  for (opt, val) in opts₁ do
    unless opts₂.find? opt |>.isEqSome val do
      sdiff := sdiff.insert opt val
  return sdiff

scoped instance : SDiff Options := ⟨Lean.Options.sdiff⟩

open ImportGraph.Splice

def ScopeCapsule.inter (s₁ s₂ : ScopeCapsule) : ScopeCapsule where
  isNoncomputable := s₁.isNoncomputable && s₂.isNoncomputable
  isPublic := s₁.isPublic && s₂.isPublic
  isMeta := s₁.isMeta && s₂.isMeta
  isExposed := s₁.isExposed && s₂.isExposed
  -- Technically, we could try to look for the longest common sublist, but this is nontrivial.
  levelNames := s₁.levelNames.commonPrefix s₂.levelNames
  currNamespace := s₁.currNamespace ∩ s₂.currNamespace
  openDecls := s₁.openDecls.inter s₂.openDecls
  activeScopes := s₁.activeScopes ∩ s₂.activeScopes
  userOpts := s₁.userOpts ∩ s₂.userOpts
  vars := s₁.vars.inter s₂.vars

instance : Inter ScopeCapsule := ⟨(·.inter)⟩

def ScopeCapsule.sdiff (s₁ s₂ : ScopeCapsule) : ScopeCapsule where
  isNoncomputable := s₁.isNoncomputable \ s₂.isNoncomputable
  isPublic := s₁.isPublic \ s₂.isPublic
  isMeta := s₁.isMeta \ s₂.isMeta
  isExposed := s₁.isExposed \ s₂.isExposed
  -- Technically we could look at ordered sublists, but that's nontrivial.
  levelNames := s₁.levelNames.sdiffByPrefix s₂.levelNames
  currNamespace := s₁.currNamespace \ s₂.currNamespace
  openDecls := s₁.openDecls.sdiff s₁.openDecls
  activeScopes := s₁.activeScopes \ s₂.activeScopes
  userOpts := s₁.userOpts \ s₂.userOpts
  vars := s₁.vars.sdiff s₂.vars

instance : SDiff ScopeCapsule := ⟨(·.sdiff)⟩
